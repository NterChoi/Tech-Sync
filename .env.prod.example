# Tech-Sync 프로덕션 환경변수 템플릿
# 사용법: 이 파일을 .env.prod 로 복사한 뒤 실제 값을 채운다. (.env.prod 는 커밋 금지)
#   cp .env.prod.example .env.prod
#
# 첫 배포 시에만 아래 DDL_AUTO 주석을 해제하여 스키마를 생성하고,
# 정상 기동을 확인한 뒤 다시 주석 처리하고 backend 컨테이너만 재기동한다.
# DDL_AUTO=update

# ── MariaDB ──────────────────────────────────────────────────
DB_ROOT_PASSWORD=change-me-root
DB_NAME=techsync
DB_USERNAME=techsync
DB_PASSWORD=change-me

# ── MongoDB ──────────────────────────────────────────────────
MONGO_DB=techsync
MONGO_USERNAME=techsync
MONGO_PASSWORD=change-me

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=change-me

# ── JWT ───────────────────────────────────────────────────────
# 반드시 Base64 인코딩된 값이어야 한다 (JwtProvider 가 Base64 디코딩 후 HMAC 키로 사용).
# 생성 예:  openssl rand -base64 48
JWT_SECRET=replace-with-base64-output-of-openssl-rand-base64-48

# ── Naver News API ───────────────────────────────────────────
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
